        {
          "inlineContent" : [
            {
              "text" : "Different backends might use different positions for label rendering. Typically",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "backends use lower left point. SVG can use centre point (using ",
              "type" : "text"
            },
            {
              "code" : "\"middle\"",
              "type" : "codeVoice"
            },
            {
              "text" : " positioning",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "attribute). This method give opportunity to the rendering backend to compute correct offset",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "without affecting the actual node position.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Default implementation returns nil – default backend behaviour.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The return value is used by the ",
