          "level" : 2,
          "text" : "Return Value",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "A tuple containing the two cubic control points (control1, control2)",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    },
    {
      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Given a quadratic Bezier curve with start point, control point, and end point,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "returns the equivalent cubic Bezier control points.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Algorithm",
          "level" : 2,
          "text" : "Algorithm",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "For quadratic Bezier: P(t) = (1-t)²P₀ + 2t(1-t)P₁ + t²P₂",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Cubic equivalent: control1 = P₀ + ⅔(P₁ - P₀), control2 = P₂ + ⅔(P₁ - P₂)",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "let start = Vector2D(0, 0)",
            "let control = Vector2D(1, 1)",
            "let end = Vector2D(2, 0)",
            "let (control1, control2) = Geometry.quadraticToCubicControls(",
            "    startPoint: start, ",
            "    quadControl: control, ",
            "    endPoint: end",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        }
      ],
      "kind" : "content"
    }
  ],
