          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "This method creates line segments between consecutive vertices of the polygon,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "including a closing segment between the last vertex and the first vertex to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "form a complete closed shape.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "O(n) where n is the number of vertices.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "Complexity",
          "style" : "note",
          "type" : "aside"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "let triangle = [",
            "    Vector2D(0, 0),",
            "    Vector2D(1, 0),",
            "    Vector2D(0.5, 1)",
            "]",
            "let segments = Geometry.toSegments(polygon: triangle)",
            "\/\/ Returns 3 segments forming a closed triangle"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "For a valid polygon, the segments will form a continuous closed path.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "Note",
          "style" : "note",
          "type" : "aside"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "The order of segments follows the order of vertices in the input array.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
