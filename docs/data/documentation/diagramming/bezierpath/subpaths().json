          "level" : 2,
          "text" : "Return Value",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Array of BezierPath objects, each representing one subpath",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    },
    {
      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "A subpath is a continuous sequence of drawing operations that ends with either",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "a closePath command or the end of the path. Multiple moveTo commands within",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the same subpath create disconnected segments but remain part of the same subpath.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "This follows the standard SVG\/PostScript behavior where only closePath",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "explicitly ends a subpath.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "var path = BezierPath()",
            "path.move(to: Vector2D(0, 0))",
            "path.addLine(to: Vector2D(5, 5))",
            "path.closeSubpath()                    \/\/ End first subpath",
            "path.move(to: Vector2D(10, 10))",
            "path.addLine(to: Vector2D(15, 15))     \/\/ Second subpath (unclosed)",
            "",
            "let subpaths = path.subpaths()         \/\/ Returns 2 subpaths"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        }
      ],
      "kind" : "content"
    }
