        },
        {
          "inlineContent" : [
            {
              "text" : "Visual mask is used to obscure content below the pictogram, provide highlight shape or",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "similar visual indication.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "The bezier path representing the mask is assumed to be a closed path or composed",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "of closed sub-paths. It is always presented as filled.",
                  "type" : "text"
                }
              ],
