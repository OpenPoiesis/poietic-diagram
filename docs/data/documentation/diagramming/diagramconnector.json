          "type" : "unorderedList"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "This is not a relationship component. From modelling perspective it is a visual",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "representation of a first-class model object. That the model object relates two other",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "model objects together is irrelevant for the concept of visual representation itself.",
                  "type" : "text"
                }
