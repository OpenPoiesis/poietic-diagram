    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Connectors visually represent relationships or flows between diagram elements.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "They can be rendered as either thin stroked paths or fat filled polygons,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "with configurable arrowheads at either or both endpoints.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The connector supports:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Direct connections between origin and target points",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Routing through intermediate midpoints",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Different visual styles (thin stroke vs fat polygon)",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Configurable arrowheads with various types and sizes",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Visual styling through ShapeStyle properties",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Objects with ",
              "type" : "text"
            },
            {
              "code" : "DiagramConnector",
              "type" : "codeVoice"
            },
            {
              "text" : " component are expected to have ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/DiagramObject",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " tag",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "as well.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Derived-Components-and-Entities",
          "level" : 2,
          "text" : "Derived Components and Entities",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Diagram connector is a logical component. Its visual representation are entities with",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorSceneNode",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " that are related to the diagram connector via ",
              "type" : "text"
            },
            {
              "code" : "\/PoieticCore\/RepresentationOf",
              "type" : "codeVoice"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "relationship. The following components are derived from the diagram connector: ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorGeometry",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ",",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorWire",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorStroke",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Interaction",
          "level" : 2,
          "text" : "Interaction",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "During interactive session, such as dragging, the temporary state of midpoints of a connector",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "are stored on the same entity as the connector in the ",
              "type" : "text"
            },
            {
              "code" : "PreviewMidpointsComponent",
              "type" : "codeVoice"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Related-components",
          "level" : 2,
          "text" : "Related components",
          "type" : "heading"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : "PreviewMidpointsComponent",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " on same entity: Preview of midpoints during interactive session.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Midpoints are in design coordinates.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorSceneNode",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " visual representation of the connector entity, specific for a viewport.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Relates to the original diagram connector through ",
                      "type" : "text"
                    },
                    {
                      "code" : "RepresentationOf",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " relationship.",
