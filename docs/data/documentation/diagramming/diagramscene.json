    },
    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "A diagram scene is the ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "concrete visual representation of a diagram",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "— a structured entity tree that carries everything needed for rendering and interaction.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "It is a bridge between the abstract design model and a specific backend",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "(Cairo surface, SVG image, etc.).",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Purpose:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Provide a renderable structure for backends to draw",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Provide geometry for hit-testing and interaction",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Ownership:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Scene is owned by a single view (or presenter). Two views of the same diagram use",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "separate scenes.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "A scene represents exactly one diagram (through ",
                      "type" : "text"
                    },
                    {
                      "code" : "RepresentationOf",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " towards ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/Diagram",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ").",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Required relationships:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "code" : "RepresentationOf",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " with ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/Diagram",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " target.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Expected components:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ViewportState",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ". If not present, then viewport with offset (0,0) and zoom of 1 is used.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Ephemeral components:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/LayoutDirty",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " – Set on data change, style change, scene sync",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/InteractionDirty",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " – Set on geometry change, data change, scene sync",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ViewportDirty",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " – Set on by Pan\/zoom",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Scene-Hierarchy",
          "level" : 2,
          "text" : "Scene Hierarchy",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Scene nodes are ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "shallow",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            },
            {
              "text" : " — children are annotations and indicators, not recursive",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "block structures. The scene root (",
              "type" : "text"
            },
            {
              "code" : "DiagramScene",
              "type" : "codeVoice"
            },
            {
              "text" : ") is NOT a ",
              "type" : "text"
            },
            {
              "code" : "SceneNode",
              "type" : "codeVoice"
            },
            {
              "text" : " — it has no position,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "no style, no interactivity.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "An example of a scene hierarchy. The children are related to their parent through ",
              "type" : "text"
            },
            {
              "code" : "ChildOf",
              "type" : "codeVoice"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "relationship. Some of known children have specific named parent-to-child relationship.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "DiagramScene                        ← root, tag component",
            "├── BlockSceneNode                  ← represents a DiagramBlock",
            "│   ├── PictogramSceneNode          ← draws the shape",
            "│   ├── LabelSceneNode (primary)    ← child, via `PrimaryLabel` relationship",
            "│   ├── LabelSceneNode (secondary)  ← child, via SecondaryLabel relationship",
            "│   ├── ValueIndicatorSceneNode     ← child, via ValueIndicator relationship",
            "│   ├── IssueIndicatorSceneNode     ← child, via IssueIndicator relationship",
            "│   └── ColorSwatchSceneNode        ← child, via ColorSwatch relationship",
            "├── ConnectorSceneNode              ← top-level, represents a DiagramConnector",
            "│   └── (no children — geometry is self-contained in components)",
            "└── Handle entities (app-defined)   ← created by tools, ChildOf scene"
          ],
          "syntax" : null,
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "Diagram scene has children with ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/SceneNode",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " tag.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Geometry",
          "level" : 2,
          "text" : "Geometry",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The node geometry is pre-computed by the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/DiagramSceneComposer",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " once, and then reused for",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "rendering and interaction.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Geometry-related components are ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/PositionComponent",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ", ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorWire",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ", ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/ConnectorGeometry",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Interaction geometry is stored in",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/Diagramming\/documentation\/Diagramming\/TouchRegion",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " for interactive scene nodes.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
